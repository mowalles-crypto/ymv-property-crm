# Copy this file to .env.local and fill in real values.
# Get these from https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only in scripts/server code
# (e.g. seeding, admin bootstrap) — must never reach the browser bundle.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
